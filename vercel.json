{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/portfolio.pdf",
      "permanent": true
    },
    {
      "source": "/dev-portfolio",
      "destination": "/portfolio.pdf",
      "permanent": true
    },
    {
      "source": "/design-portfolio",
      "destination": "/portfolio.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
