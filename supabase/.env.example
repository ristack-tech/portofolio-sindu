# ============================================================
# Supabase Environment Variables — TEMPLATE
# ============================================================
# Copy file ini jadi `.env` di root repo, lalu isi dengan nilai
# asli dari Supabase Dashboard → Settings → API.
#
# JANGAN COMMIT `.env` (sudah di .gitignore).
# ============================================================

# Supabase Project URL (Settings → API → Project URL)
# Bentuk: https://<project-ref>.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon public key (Settings → API → Project API keys → anon public)
# Bentuk: sb_publishable_xxx atau eyJhbGc... (JWT format)
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Service role key (Settings → API → Project API keys → service_role)
# ⚠️ RAHASIA! Bypass Row Level Security. JANGAN share atau commit.
# Bentuk: eyJhbGc... (JWT format, panjang)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# Astro-specific (prefix PUBLIC_ agar masuk client bundle)
# ============================================================
# Vite/Astro otomatis expose env var dengan prefix PUBLIC_ ke client.
# Variabel TANPA prefix hanya tersedia di server-side.
#
# Di Supabase, key ANON aman untuk client (RLS enforce).
# Key SERVICE_ROLE JANGAN pernah pakai prefix PUBLIC_.
# ============================================================

# Untuk Astro, duplikasi dengan prefix PUBLIC_:
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Vercel Deploy Hook (opsional, untuk auto-rebuild saat admin save)
# ============================================================
# Buat di: Vercel → Project → Settings → Git → Deploy Hooks
# Format: https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy
VERCEL_DEPLOY_HOOK_URL=